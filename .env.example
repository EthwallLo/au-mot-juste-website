ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi
ADMIN_SESSION_SECRET=une-longue-chaine-aleatoire

# Développement : base et images enregistrées sur cet ordinateur.
LOCAL_DATABASE_PATH=.local/database
LOCAL_IMAGES_PATH=.local/images

# Vercel utilise ses propres DATABASE_URL (Neon) et BLOB_READ_WRITE_TOKEN.
# Ces identifiants de production ne sont pas nécessaires dans .env.local.

# Prototype newsletter : local uniquement, aucun e-mail réel envoyé.
NEWSLETTER_LOCAL_ENABLED=false
